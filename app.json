{
  "expo": {
    "name": "mediskip",
    "slug": "kamsoft_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mediskip-icon.png",
    "scheme": "kamsoftmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Autoriser mediskip à accéder à votre position GPS pour localiser les pharmacies à proximité.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Autoriser mediskip à utiliser votre position GPS pour calculer les itinéraires."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mediskip-adaptive-foreground.png",
        "monochromeImage": "./assets/images/mediskip-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kamkoum.kamsoft_mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mediskip-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8F7",
          "image": "./assets/images/splash-mediskip.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "android": {
            "backgroundColor": "#F4F8F7",
            "image": "./assets/images/splash-icon-android12.png",
            "imageWidth": 100,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser mediskip à utiliser votre position.",
          "locationWhenInUsePermission": "Autoriser mediskip à utiliser votre position lorsqu'elle est ouverte."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-build-properties",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35c25cde-823f-4638-9723-de6adb747092"
      }
    }
  }
}
